# Email via SendByte (primary, recommended) + Nodemailer SMTP fallback
# SendByte domain: iyinekititechfest.com — add in https://app.sendbyte.africa dashboard, publish 3 DNS records, then use sk_live_ key
# SENDBYTE_API_KEY=sk_test_...   # sandbox: no domain needed, simulates delivery end-to-end
# SENDBYTE_API_KEY=sk_live_...   # production: domain must be verified, else 403 domain_not_verified
# EMAIL_FROM must be at verified domain for live sends, e.g. noreply@iyinekititechfest.com

# Email via Nodemailer (SMTP) — fallback when SENDBYTE_API_KEY not set or 451/429
# Option A — Gmail (recommended for low volume):
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx  (Google App Password, with 2-Step Verification)
# EMAIL_FROM=Iyin-Ekiti TechFest <you@gmail.com>
# Option B — any SMTP host:
# SMTP_HOST=smtp.yourhost.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_pass
# SMTP_SECURE=false  # true for 465
# Alternative: SendByte over SMTP (no code change, same pipeline as REST):
# SMTP_HOST=smtp.sendbyte.africa
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=sk_live_...  # your SendByte API key
# SMTP_SECURE=false
